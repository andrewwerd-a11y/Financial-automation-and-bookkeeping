# API server
PORT=4100
PUBLIC_BASE_URL=http://localhost:4100

# USAJOBS public search API (free key: https://developer.usajobs.gov/)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com

# Upwork OAuth2 app (https://www.upwork.com/developer)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# AI assistant (Claude). Without it, /workers/:id/assistant returns 503.
ANTHROPIC_API_KEY=

# Vault master keys: comma-separated id:base64(32 bytes). Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Keep old keys listed after rotating; VAULT_ACTIVE_KEY picks the one used for new data.
VAULT_MASTER_KEYS=
VAULT_ACTIVE_KEY=
